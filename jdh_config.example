# 简单鹤音形挂载 2.8 配置
# 放到 /sdcard/Download/jdh_config，改完强停豆包重开生效。

enable=1

# 简单鹤介入的最小码长（1~4）
min_exact_len=1

# 全塞：简单鹤该码的候选排最前，豆包自己的候选原样顺延在后，一个都不删
merge_all=1

# 单码候选总数上限（含豆包）。简单鹤个别符号码有 89 个候选，必须封顶
max_total=24

# 前缀兜底：没精确命中时用较短编码的候选顶上。默认关闭
merge_prefix=0

# 点击对齐：豆包按自己的候选ID取词，所以点简单鹤格子时把结果换成格子上那个词
# 只在「画面编码 == 当前编码」时才生效，不会跨编码误替换
click_fix=1
click_ttl_ms=2500

# 空格上屏：替换成简单鹤首选
space_override=1
space_ttl_ms=1500

# 1=写过程日志；0=只写 INIT/ERR（2.6 起默认 0，减少打字路径开销）
debug=0